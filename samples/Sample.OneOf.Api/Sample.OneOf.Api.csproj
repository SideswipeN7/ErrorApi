<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.OneOf.Api</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Generated sources land in obj/generated so they can be read and diffed. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <!-- One reference is enough in a real project: the adapter package carries the generator with it.
         Here the generator comes from the repository, which project references cannot flow on their own. -->
    <ProjectReference Include="..\..\src\ErrorApi.OneOf\ErrorApi.OneOf.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.Generator\ErrorApi.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
