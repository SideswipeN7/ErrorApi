<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sample.Shared.Errors</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>

    <!-- Producer-side knob, spelled out although it is already the default for a project with no
         endpoints. This project knows nothing about the API that consumes it — the property only says
         "bake what my members can reach into my own assembly". -->
    <ErrorApiExportReachability>true</ErrorApiExportReachability>
  </PropertyGroup>

  <ItemGroup>
    <!-- No endpoints anywhere in this project: the generator treats it as a library, walks its own
         public surface, and bakes CatalogExport + ReachabilityExport attributes into the assembly for
         Sample.Toolbox.Api to read back through the reference. -->
    <ProjectReference Include="..\..\src\ErrorApi.Abstractions\ErrorApi.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.Generator\ErrorApi.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
