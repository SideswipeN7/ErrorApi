<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);EAPI002;EAPI006;EAPI007</NoWarn>

    <!-- The version of OneOf under test. Override it to run this suite against another release:
         dotnet test tests/ErrorApi.OneOf.Tests -p:OneOfTestVersion=x.y.z -->
    <OneOfTestVersion Condition="'$(OneOfTestVersion)' == ''">3.0.271</OneOfTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OneOf" VersionOverride="$(OneOfTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErrorApi.TestKit\ErrorApi.TestKit.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.OneOf\ErrorApi.OneOf.csproj" />
  </ItemGroup>

</Project>
