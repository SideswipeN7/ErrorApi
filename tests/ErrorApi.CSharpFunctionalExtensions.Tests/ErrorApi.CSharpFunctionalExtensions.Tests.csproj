<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);EAPI002;EAPI006;EAPI007</NoWarn>

    <!-- The version of CSharpFunctionalExtensions under test. Override it to run this suite against
         another release: dotnet test tests/ErrorApi.CSharpFunctionalExtensions.Tests -p:CfeTestVersion=x.y.z -->
    <CfeTestVersion Condition="'$(CfeTestVersion)' == ''">3.7.0</CfeTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CSharpFunctionalExtensions" VersionOverride="$(CfeTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErrorApi.TestKit\ErrorApi.TestKit.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.CSharpFunctionalExtensions\ErrorApi.CSharpFunctionalExtensions.csproj" />
  </ItemGroup>

</Project>
