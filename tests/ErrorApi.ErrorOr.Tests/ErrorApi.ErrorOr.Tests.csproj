<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);EAPI002;EAPI006;EAPI007</NoWarn>

    <!-- The version of ErrorOr under test. Override it to run this suite against another release:
         dotnet test tests/ErrorApi.ErrorOr.Tests -p:ErrorOrTestVersion=x.y.z -->
    <ErrorOrTestVersion Condition="'$(ErrorOrTestVersion)' == ''">2.1.1</ErrorOrTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ErrorOr" VersionOverride="$(ErrorOrTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErrorApi.TestKit\ErrorApi.TestKit.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.ErrorOr\ErrorApi.ErrorOr.csproj" />
  </ItemGroup>

</Project>
