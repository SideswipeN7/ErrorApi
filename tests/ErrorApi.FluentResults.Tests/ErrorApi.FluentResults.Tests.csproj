<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi.Generator.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);EAPI002;EAPI006;EAPI007</NoWarn>

    <!-- The version of FluentResults under test. Override it to run this suite against another release:
         dotnet test tests/ErrorApi.FluentResults.Tests -p:FluentResultsTestVersion=x.y.z -->
    <FluentResultsTestVersion Condition="'$(FluentResultsTestVersion)' == ''">3.16.0</FluentResultsTestVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="FluentResults" VersionOverride="$(FluentResultsTestVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErrorApi.TestKit\ErrorApi.TestKit.csproj" />
    <ProjectReference Include="..\..\src\ErrorApi.FluentResults\ErrorApi.FluentResults.csproj" />
  </ItemGroup>

</Project>
