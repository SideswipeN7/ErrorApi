<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>ErrorApi.Interop</RootNamespace>
    <PackageId>ErrorApi.OneOf</PackageId>
    <Description>Maps OneOf results onto Minimal API results and ErrorApi's documented error catalog.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="OneOf" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the source generator still reaches a project that references only this
         adapter; NuGet's default strips analyzers out of a transitive dependency. -->
    <ProjectReference Include="..\ErrorApi.AspNetCore\ErrorApi.AspNetCore.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
