<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi</RootNamespace>
    <PackageId>ErrorApi.AspNetCore</PackageId>
    <Description>Minimal API integration for ErrorApi: Result to IResult mapping, OpenAPI error responses, and a TypeScript error contract. Ships the source generator.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <!-- MapErrorContract takes its pattern as a parameter on purpose; the endpoint is not documented. -->
    <NoWarn>$(NoWarn);EAPI002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ErrorApi.Generator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErrorApi.Abstractions\ErrorApi.Abstractions.csproj" />
    <ProjectReference Include="..\ErrorApi.Generator\ErrorApi.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Label="Ship the generator inside the package">
    <None Include="..\ErrorApi.Generator\bin\$(Configuration)\netstandard2.0\ErrorApi.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

    <!-- The MSBuild-property wiring (ErrorApiExportReachability, ErrorApiIncludeAssemblies). Shipped in
         both build folders so it applies to direct and transitive consumers alike. -->
    <None Include="buildTransitive\ErrorApi.AspNetCore.props" Pack="true" PackagePath="build" Visible="false" />
    <None Include="buildTransitive\ErrorApi.AspNetCore.props" Pack="true" PackagePath="buildTransitive" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\SharedNormalization.cs" Link="Shared\SharedNormalization.cs" />
  </ItemGroup>

</Project>