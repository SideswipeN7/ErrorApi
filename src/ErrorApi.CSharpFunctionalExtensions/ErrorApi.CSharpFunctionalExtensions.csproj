<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ErrorApi.Interop</RootNamespace>
    <PackageId>ErrorApi.CSharpFunctionalExtensions</PackageId>
    <Description>Maps CSharpFunctionalExtensions results onto Minimal API results and ErrorApi's documented error catalog.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CSharpFunctionalExtensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none" so the source generator still reaches a project that references only this
         adapter; NuGet's default strips analyzers out of a transitive dependency. -->
    <ProjectReference Include="..\ErrorApi.AspNetCore\ErrorApi.AspNetCore.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
