<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>ErrorApi contributors</Authors>
    <Product>ErrorApi</Product>
    <PackageProjectUrl>https://github.com/SideswipeN7/ErrorApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SideswipeN7/ErrorApi</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>source-generator;openapi;minimal-api;result;problemdetails;aot;typescript</PackageTags>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- A package ships its own README when it has one; the adapters each describe their own library.
       Everything else falls back to the repository README. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildProjectDirectory)\README.md"
          Condition="Exists('$(MSBuildProjectDirectory)\README.md')"
          Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md"
          Condition="!Exists('$(MSBuildProjectDirectory)\README.md')"
          Pack="true" PackagePath="\" Visible="false" />

    <!-- NuGet renders the package icon from a raster file, so the mark is shipped as a 128px PNG. -->
    <None Include="$(MSBuildThisFileDirectory)docs\images\logo-mark.png"
          Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>
